# ─── Production URL ──────────────────────────────────────────────
# Set only once ogaalacademy.so is registered and points at this deployment.
NEXT_PUBLIC_SITE_URL=

# ─── Where form enquiries are delivered ──────────────────────────
# Default is info@ogaalacademy.so. Comma-separate to send to several inboxes.
ENQUIRY_TO_EMAIL=info@ogaalacademy.so

# ─── OPTION A (recommended): send through the info@ogaalacademy.so mailbox (SMTP) ───
# Use the "outgoing mail (SMTP)" settings from your email provider. Server-side only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@ogaalacademy.so
SMTP_PASS=
# Optional: sender name/address shown in the inbox
# SMTP_FROM="OGAAL Academy Website <info@ogaalacademy.so>"
# Optional: force TLS mode (default: true for port 465, STARTTLS for 587)
# SMTP_SECURE=true

# ─── OPTION B: Resend API (use instead of SMTP) ──────────────────
# RESEND_API_KEY=
# ENQUIRY_FROM_EMAIL="OGAAL Academy <enquiries@ogaalacademy.so>"

# ─── Certificate portal (optional: the public site runs without these) ───
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Public address of this deployment. Used in certificate QR codes and password reset links.
PORTAL_BASE_URL=https://example.com
# Private files. Must be outside public/ and outside the deployment folder.
STORAGE_DIR=/var/lib/ogaal/storage
# Certificate dates and displayed times.
APP_TIMEZONE=Africa/Mogadishu
# Number of proxies in front of the app that append to X-Forwarded-For.
TRUSTED_PROXY_COUNT=1

# ─── Backups ─────────────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_DIR=/var/backups/ogaal
BACKUP_RETENTION_DAYS=30
# Only if mysqldump is not on the PATH
# MYSQLDUMP_PATH=/usr/bin/mysqldump
